---
import "@/styles/global.css";
import "@/styles/atrio.css";
import { getBusinessStyles } from "@/lib/styles";

interface Props {
  title?: string;
  template?: string;
  platform?: string;
  styleVars?: Record<string, string>;
}

const { title = "Atrio", template, platform, styleVars } = Astro.props;

const styles = platform ? undefined : (styleVars ?? getBusinessStyles());

---

<!doctype html>
<html lang="es" data-platform={platform} data-template={template} style={styles}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
