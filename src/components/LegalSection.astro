---
interface Props {
  id: string;
  number: string;
  heading: string;
}

const { id, number, heading } = Astro.props;
---

<section
  id={id}
  class="border-t border-container-high pt-8"
  aria-labelledby={`${id}-title`}
>
  <div class="grid gap-x-5 gap-y-2 md:grid-cols-[3.25rem_minmax(0,1fr)]">
    <span
      class="font-display text-sm font-extrabold tabular-nums tracking-[0.04em] text-secondary md:pt-1.5 md:text-right"
      aria-hidden="true">{number}</span>
    <div class="min-w-0">
      <h2
        id={`${id}-title`}
        class="font-display text-xl font-bold tracking-[-0.01em] text-ink sm:text-2xl"
      >
        {heading}
      </h2>
      <div class="mt-3 flex flex-col gap-4 text-[0.9375rem] leading-[1.7] text-muted">
        <slot />
      </div>
    </div>
  </div>
</section>
